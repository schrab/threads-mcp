# Long-lived Threads access token (60 days) from the dashboard's user-token
# generator. See README section 1.
THREADS_ACCESS_TOKEN=your-long-lived-token-here

# Numeric Threads profile id of the account that will post. Sent by the token
# generator alongside the token; must match the token's owner.
THREADS_USER_ID=your-numeric-threads-user-id

# Threads app secret (Settings -> Basic -> Threads App secret), used to compute
# appsecret_proof. The Meta App secret is NOT interchangeable with this one.
THREADS_APP_SECRET=your-threads-app-secret-here
