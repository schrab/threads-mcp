# Long-lived Threads access token (60 days; see README for how to obtain)
THREADS_ACCESS_TOKEN=your-long-lived-token-here

# Numeric Threads profile id of the account that will post
THREADS_USER_ID=17841406385576486

# Meta app secret, used to compute appsecret_proof for server-side calls
THREADS_APP_SECRET=your-app-secret-here
